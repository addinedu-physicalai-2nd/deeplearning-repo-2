/* ========================================================= */
/* MAIN                                                      */
/* ========================================================= */

QMainWindow {
    background-color: #07111F;
}

QWidget#centralwidget {
    background-color: #07111F;
}


/* ========================================================= */
/* TOP BAR                                                   */
/* ========================================================= */

QFrame#topFrame {
    background-color: #0B1728;
    border-bottom: 1px solid #1D314A;
}

QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 700;
}

QLabel#subTitleLabel {
    color: #5E9CFF;
    font-size: 11px;
    font-weight: 600;
}

QLabel#statusDot {
    color: #39D98A;
    font-size: 19px;
}

QLabel#statusLabel {
    color: #B8C7D8;
    font-size: 13px;
    font-weight: 500;
}


/* ========================================================= */
/* VIDEO                                                     */
/* ========================================================= */

QFrame#videoFrame {
    background-color: #02060B;
    border: 1px solid #203650;
    border-radius: 12px;
}

QLabel#videoLabel {
    background-color: #010409;
    color: #53677C;
    border-radius: 9px;
    font-size: 20px;
    font-weight: 600;
}


/* ========================================================= */
/* BOTTOM PANEL                                              */
/* ========================================================= */

QFrame#bottomFrame {
    background-color: #0B1728;
    border: 1px solid #1D314A;
    border-radius: 12px;
}

QLabel#assistLabel {
    color: #778DA6;
    font-size: 11px;
    font-weight: 700;
}

QLabel#fpsTitleLabel {
    color: #7D91A7;
    font-size: 11px;
    font-weight: 700;
}

QLabel#fpsValueLabel {
    color: #FFFFFF;
    font-size: 27px;
    font-weight: 700;
}

QLabel#fpsUnitLabel {
    color: #60758B;
    font-size: 11px;
}


/* ========================================================= */
/* FEATURE BUTTONS - OFF                                     */
/* ========================================================= */

QPushButton#laneButton,
QPushButton#obstacleButton,
QPushButton#hazardButton {
    background-color: #111F31;
    color: #8799AC;

    border: 1px solid #243B55;
    border-radius: 10px;

    padding: 6px 16px;

    font-size: 13px;
    font-weight: 600;
}

QPushButton#laneButton:hover,
QPushButton#obstacleButton:hover,
QPushButton#hazardButton:hover {
    background-color: #172A40;
    border: 1px solid #3A5C80;
    color: #D9E6F4;
}


/* ========================================================= */
/* FEATURE BUTTONS - ON                                      */
/* ========================================================= */

QPushButton#laneButton:checked,
QPushButton#obstacleButton:checked,
QPushButton#hazardButton:checked {
    background-color: #1769E0;
    color: #FFFFFF;

    border: 1px solid #3B8CFF;
    border-bottom: 3px solid #0A51BA;
}


/* ========================================================= */
/* DASHCAM OFF                                               */
/* ========================================================= */

QPushButton#dashcamButton {
    background-color: #111F31;
    color: #8799AC;

    border: 1px solid #243B55;
    border-radius: 10px;

    padding: 6px 16px;

    font-size: 13px;
    font-weight: 600;
}

QPushButton#dashcamButton:hover {
    background-color: #172A40;
    border: 1px solid #5A3B43;
    color: #FFFFFF;
}


/* ========================================================= */
/* DASHCAM ON                                                */
/* ========================================================= */

QPushButton#dashcamButton:checked {
    background-color: #C93645;
    color: #FFFFFF;

    border: 1px solid #F05B68;
    border-bottom: 3px solid #8F1F2A;
}

   </string>
